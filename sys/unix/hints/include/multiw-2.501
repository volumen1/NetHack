#------------------------------------------------------------------------------
# NetHack 5.0  multiw-2
#
# Sets up the curses interface, the only one this fork builds.
#
# The following will be set appropriately following this:
#     - WINCFLAGS
#     - WINSRC
#     - WINOBJ0
#---

WINCFLAGS = -DNOTTYGRAPHICS -DCURSES_GRAPHICS
ifeq "$(USE_GENL_PUTMIXED)" "1"
WINCFLAGS += -DUSE_GENL_PUTMIXED
else
WINCFLAGS += -D_XOPEN_SOURCE_EXTENDED=1
endif
WINSRC = $(WINCURSESSRC)
WINOBJ0 = $(WINCURSESOBJ)

ifeq "$(musl)" "1"
MUSL=1
endif
ifeq "$(MUSL)" "1"
ifneq "$(NOCRASHREPORT)" "1"
NOCRASHREPORT=1
endif
WINCFLAGS += -DMUSL_LIBC
# use this instead of col -bx
COLCMD=../util/stripbs
STRIPBS=../util/stripbs
else
WINCFLAGS += -DGNU_LIBC
endif

ifeq "$(NOCRASHREPORT)" "1"
WINCFLAGS += -DNOCRASHREPORT
endif

#end of hints/include/multiw-2
#------------------------------------------------------------------------------
